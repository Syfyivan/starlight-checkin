# Keep real values in /var/lib/starlight/runtime.env (mode 600), outside releases.
# Pass ENV_FILE=/var/lib/starlight/runtime.env to deploy/run-container.sh.
# Unconfigured providers are explicitly disabled in the UI.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Exact OAuth callback URL:
# https://124-221-36-36.anyip.dev:8443/starlight/api/auth/github/callback
RESEND_API_KEY=
# Use an address on a verified Resend sending domain.
MAIL_FROM=
